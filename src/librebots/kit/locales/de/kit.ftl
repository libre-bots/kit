kit-error-hub = Ich komme gerade nicht an meine Daten. Versuch es in einer Minute noch einmal.
    .title = Gerade nicht erreichbar
kit-error-forbidden = Mir fehlt dafür eine Berechtigung. Bitte einen Server-Admin, meine Rolle zu prüfen.
    .title = Berechtigung fehlt
kit-error-unknown = Versuch es später noch einmal. Wenn es wieder passiert, gib dem Betreiber des Bots diese Referenz: `{ $reference }`
    .title = Etwas ist schiefgelaufen

kit-cmd-info =
    .name = info
    .description = Zeigt, was dieser Bot ist, wer ihn betreibt und wo sein Code liegt
kit-info-meta = Version { $version } · { $servers } Server · Betrieben von { $operator } ({ $contact })
kit-info-meta-without-servers = Version { $version } · Betrieben von { $operator } ({ $contact })
kit-info-privacy = Mit /privacy siehst, exportierst oder löschst du, was dieser Bot über dich speichert.
kit-info-source = Quellcode
kit-info-support = Support
kit-info-privacy-policy = Datenschutzerklärung

kit-cmd-privacy =
    .name = privacy
    .description = Sieh dir an, was dieser Bot über dich speichert, exportiere oder lösche es
kit-privacy-overview = { $operator } ({ $contact }) betreibt diese Instanz von { $bot }.
    .title = Deine Daten
    .stored = Über dich gespeichert:
    .nothing = Über dich ist nichts gespeichert.
    .policy = Datenschutzerklärung
kit-privacy-export = Diese Datei enthält alles, was { $bot } über dich speichert.
    .title = Dein Datenexport
    .button = Meine Daten exportieren
kit-privacy-delete = Damit löschst du alles, was { $bot } über dich speichert, in jedem Server:
    .title = Alles über dich löschen?
    .warning = Das lässt sich nicht rückgängig machen. Exportiere deine Daten vorher, wenn du eine Kopie willst.
    .button = Meine Daten löschen
    .confirm = Alles löschen
    .modal = Alle deine Daten löschen
    .input = Gib zur Bestätigung deinen Nutzernamen ein
    .mismatch = Das ist nicht dein Nutzername, deshalb wurde nichts gelöscht.
kit-privacy-deleting = Deine Daten werden im Hintergrund gelöscht. Das kann ein paar Minuten dauern.
    .title = Löschung gestartet
kit-privacy-server = Damit löschst du alles, was { $bot } über diesen Server speichert:
    .title = Daten dieses Servers löschen?
    .warning = Das lässt sich nicht rückgängig machen. Die Nachrichten des Bots im Server bleiben.
    .button = Daten dieses Servers löschen
    .confirm = Serverdaten löschen
    .modal = Daten dieses Servers löschen
    .input = Gib zur Bestätigung den Servernamen ein
    .mismatch = Das ist nicht der Name des Servers, deshalb wurde nichts gelöscht.
    .owner-only = Nur der Eigentümer des Servers kann dessen Daten löschen.
kit-privacy-server-deleted = { $bot } hat gelöscht:
    .title = Serverdaten gelöscht
    .nothing = { $bot } hatte über diesen Server nichts gespeichert.
kit-privacy-not-deleted =
    .title = Nichts gelöscht
kit-privacy-cancel = Abbrechen
